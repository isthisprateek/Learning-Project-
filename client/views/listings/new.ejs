<% layout("/layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">
            <br/>
            <h2>Create a new Listing</h2>
            <br/>
            <form method="POST" action="/listings" class="needs-validation" enctype="multipart/form-data" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="title">Title</label>
                    <input 
                    name="listing[title]" 
                    class="form-control"
                    placeholder="Add a Catchy Title" 
                    required
                    type="text"> 
                    <div class="valid-feedback">Title looks good.</div>    
                </div>
                <br/> 
                
                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea
                    name="listing[description]" 
                    class="form-control"
                    placeholder="Enter Description" 
                    required
                    type="text"></textarea> 
                    <div class="invalid-feedback">Please enter a short Description</div> 
                </div>

                <br/> 
                <div class="mb-3">
                    <label class="form-label" for="image">Upload Listing Image</label>
                    <input 
                    name="listing[image]" 
                    class="form-control" 
                    type="file"> 
                </div>
                <br/> 
                
                <div class="mb-3">
                    <label class="form-label" for="price">Price</label>
                    <input 
                    name="listing[price]" 
                    class="form-control"
                    placeholder=" Enter Price" 
                    required
                    type="text"> 
                    <div class="invalid-feedback">Please enter a Valid Price</div> 
                </div>
                <br/> 
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label class="form-label" for="country">Country</label>
                        <input 
                        name="listing[country]" 
                        class="form-control"
                        placeholder="India / Nepal" 
                        required
                        type="text"> 
                        <div class="invalid-feedback">Please enter a Valid Country</div> 
                    </div>
                    <br/> 
                    
                    <div class="mb-3 col-md-8">
                        <label class="form-label" for="location">Location</label>
                        <input 
                        name="listing[location]" 
                        class="form-control"
                        placeholder="Jaipur, Delhi , Mumbai" 
                        required
                        type="text"> 
                        <div class="invalid-feedback">Please enter a Valid Location</div> 
                    </div>
                    <br/> 

                </div>
                
                <button class="btn btn-dark add-btn">Submit</button><br/><br/>
            </form>
            
        </div>
        
    </div>
        
        