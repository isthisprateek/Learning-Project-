<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-4 justify-content-center">
    <div class="col-lg-8">
        <h2 class="show-title"><i><%= listing.title %></i></h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="listing-card show-card mb-4">
            <img src="<%= listing.image.url %>"
                 class="card-img-top show-img"
                 alt="<%= listing.title %>" />

            <div class="card-body show-card mt-3">
                <p class="mb-1"><i class="text-muted">Owned By</i> — <b><%= listing.owner.username %></b></p>
                <p class="listing-description"><%= listing.description %></p>
                <ul class="list-unstyled listing-meta">
                    <li><i class="fa-solid fa-tag me-2"></i>&#8377;<%= listing.price.toLocaleString("en-IN") %> / night</li>
                    <li><i class="fa-solid fa-location-dot me-2"></i><%= listing.location %></li>
                    <li><i class="fa-solid fa-flag me-2"></i><%= listing.country %></li>
                </ul>
            </div>
        </div>

        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns mb-4 d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-warning">Edit this Listing</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
                <button class="btn btn-outline-danger">Delete this Listing</button>
            </form>
        </div>
        <% } %>

        <hr />

        <% if (currUser) { %>
        <h4 class="mb-3">Leave a Review</h4>
        <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation mb-4">
            <div class="mb-3 col-md-5">
                <label for="rating" class="form-label">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>
            <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea class="form-control" name="review[comment]" id="comment" rows="4" required></textarea>
                <div class="invalid-feedback">Please enter some comments to submit</div>
            </div>
            <button class="btn btn-success">Submit</button>
        </form>
        <hr />
        <% } %>

        <% if (listing.reviews.length) { %>
        <h4 class="mb-3">All Reviews</h4>
        <div class="row">
            <% for (review of listing.reviews) { %>
            <div class="col-md-6 mb-3">
                <div class="card review-card h-100">
                    <div class="card-body">
                        <h6 class="card-title">@<%= review.author.username %></h6>
                        <p class="starability-result" data-rating="<%= review.rating %>">
                            Rated: <%= review.rating %> stars
                        </p>
                        <p class="card-text"><%= review.comment %></p>
                        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                        <% } %>
                    </div>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>

        <div class="mt-4 mb-5">
            <h3 class="mb-3">Where You'll be</h3>
            <div id="map" class="map-box"></div>
            <button id="show-route-btn" class="btn btn-primary mt-3">
                <i class="fa-solid fa-route me-2"></i>Show route from my location
            </button>
        </div>
    </div>
</div>

<script src="/JS/map.js"></script>
