<% layout("/layouts/boilerplate") %>
<body>
    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>";
        const listing = <%- JSON.stringify(listing)%>;
    </script>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3><i> <%= listing.title  %></i> </h3>
        </div>
                <div class="listing-card col-5 offset-3 show-card">
                    <img src="<%= listing.image.url %>" 
                      class="card-img-top show-img" 
                      alt="..." 
                    />
                    <br/>
                    <div class="card-body show-card">
                        <p class="card-text">
                         <i><u>Owned By</u> : <b><%= listing.owner.username %></b></i><br/>
                         <b> <%= listing.description  %> </b> <br/>
                         <i>Price</i> - &#8377; <%= listing.price.toLocaleString("en-IN") %> / night <br/>
                         <i>Location</i> - <%= listing.location  %><br/>
                         <i>Country</i> - <%= listing.country  %><br/>
                        </p>
                    </div>
                </div>
                <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                <div class="btns">
                    
                    <a href="/listings/<%= listing._id  %>/edit " class="btn btn-outline-warning mt-2 offset-4">Edit this <br/>Listing</a>

                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-outline-danger col-10 mt-2 offset-6">Delete this Listing</button>
                    </form>

                </div>
                <% } %>
                <div class="col-8 offset-3">
                    <br/><hr/>
                    <% if(currUser) { %>
                    <h4>Leave a Review</h4>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                        <div class="mb-3 mt-3 col-4">
                            <label for="rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea class="form-control" name="review[comment] " id="comment" cols="35" rows="5" required ></textarea>
                            <div class="invalid-feedback">Please enter some comments to submit</div>
                        </div>
                        <br/>

                        <button class="btn btn-success">Submit</button>
                        <br/><hr/>
                    </form>
                    <% } %>
                    <% if(listing.reviews.length) { %>
                        <hr/>
                    <p>
                        <div class="row">
                            <h4>All Reviews</h4>
                            <% for(review of listing.reviews) {  %>
                                <div class="card col-5 ms-3 mb-3">
                                    <div class="card-body">
                                        <h5 class="card-title mt-2">
                                            @<%= review.author.username %>
                                        </h5>
                                        <p class="starability-result" data-rating=<%= review.rating %>>
    Rated: <%= review.rating %> stars
  </p>
                                        <p class="card-text"> <%= review.comment  %> </p>
                                    </div>
                                    <br/>
                                <form class="mb-3" 
                                        method="POST" 
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                                    <button class="btn btn-sm btn-primary">Delete</button>
                                </form>    
                                </div>
                            <% } %>
                        </div>
                    </p>
                    <% } %>
                </div>
                <div class="col-6 offset-3 mb-3">
                    <h3>Where You'll be</h3>
                    <div id="map"></div>
                </div>
        </div>
    <script src="/js/map.js"></script>
</body>
