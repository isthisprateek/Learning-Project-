<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
             <h3>Edit the Listing : <%= listing._id %></h3>
             <form method="POST" 
             action="/listings/<%= listing._id  %>?_method=PUT" 
             class="needs-validation" 
             novalidate
            enctype="multipart/form-data"
             >
                 <div class="mb-3">
                     <label class="form-label" for="title">Title</label>
                     <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required> <br/> <br/>
                     <div class="invalid-feedback">Please enter a Title </div> 
                 </div>
                 <div class="mb-3">
                     <label class="form-label" for="description">Description</label>
                     <textarea name="listing[description]" type="text" class="form-control" required><%= listing.description  %></textarea> <br/> <br/>
                     <div class="invalid-feedback">Please enter a Short Description</div> 
                 </div>

                 <div class="mb-3" >
                    Old Image
                    <img src="<%= origImage %>" />
                 </div>

                 <div class="mb-3">
                     <label class="form-label" for="image">Upload new page</label>
                     <input name="listing[image]"  class="form-control" type="file"> <br/> <br/>
                 </div>
                 <div class="row">
                     <div class="mb-3 col-md-4">
                         <label class="form-label" for="price">Price</label>
                         <input name="listing[price]" value="<%= listing.price %>" class="form-control" type="number" required> <br/> <br/>
                         <div class="invalid-feedback">Please enter a Valid Price</div> 
                     </div>
                     <div class="mb-3 col-md-8">
                         <label class="form-label" for="country">Country</label>
                         <input name="listing[country]" value="<%= listing.country %>" class="form-control" type="text" required> <br/> <br/>
                         <div class="invalid-feedback">Please enter a Valid country</div> 
                     </div>
                 </div>
                 <div class="mb-3">
                     <label class="form-label" for="location">Location</label>
                     <input name="listing[location]" value="<%= listing.location %>" class="form-control" type="text" required> <br/>
                     <div class="invalid-feedback">Please enter a Valid Location</div> 
                 </div>

                 <button class="btn btn-outline-dark add-btn1" type="submit">Edit</button> <br/><br/>
         </div>
    </div>
    </form>
    <script src="/JS/script.js"></script>
</body>
